<!--
  Top of the vophone home screen: the day and date in big letters on the left,
  the clock and the battery on the right.
  The old buttons (sos, flash, sound, notifications) stay hidden here: SOS is a tile now,
  and the rest moved to the "Mais" screen.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/home_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="?bald_text_on_background"
            android:textSize="26dp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/home_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:format12Hour="@string/home_date_pattern"
            android:format24Hour="@string/home_date_pattern"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="?bald_text_on_background"
            android:textSize="18dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/home_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="?bald_text_on_background"
            android:textSize="54dp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.bald.uriah.baldphone.views.BatteryView
                android:id="@+id/battery"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:src="@drawable/battery_unknown_on_background" />

            <TextView
                android:id="@+id/battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?bald_text_on_background"
                android:textSize="18dp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <com.bald.uriah.baldphone.views.BaldImageButton
        android:id="@+id/sos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/emergency"
        android:visibility="gone" />

    <com.bald.uriah.baldphone.views.BaldImageButton
        android:id="@+id/flash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/flashlight_off_on_background"
        android:visibility="gone" />

    <com.bald.uriah.baldphone.views.BaldImageButton
        android:id="@+id/sound"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/sound_on_background"
        android:visibility="gone" />

    <com.bald.uriah.baldphone.views.BaldImageButton
        android:id="@+id/notifications"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/notification_alot_on_background"
        android:visibility="gone" />
</LinearLayout>
