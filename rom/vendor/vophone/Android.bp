// vophone built into the system image as the phone's whole interface:
// it replaces the stock home screen (Launcher3 / Trebuchet) and the stock phone app (Dialer).
android_app_import {
    name: "Vophone",
    apk: "prebuilt/vophone.apk",
    // Keep vophone's own signing key (app/vophone-debug.keystore), so later
    // `adb install -r` updates of vophone keep working on the installed system.
    presigned: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
    // Removed from the system: vophone replaces them, or they only add confusion.
    // Delete a line to keep that app.
    overrides: [
        // home screen (vophone is the home screen)
        "Launcher3",
        "Launcher3QuickStep",
        "Trebuchet",
        "TrebuchetQuickStep",
        // phone app (vophone is the phone app)
        "Dialer",
        // LineageOS updater: an official update would not include vophone
        "Updater",
        // extras an elderly user does not need
        "AudioFX",
        "Eleven",
        "Twelve",
        "Recorder",
        "Etar",
    ],
}
