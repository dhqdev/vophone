<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- vophone is the default (and system) phone app: its big-button call screen handles every call,
         and it may place emergency calls directly. Android 10 or newer. -->
    <string name="config_defaultDialer" translatable="false">com.bald.uriah.baldphone</string>

    <!-- Back / Home buttons at the bottom of the screen instead of swipe gestures
         (0 = 3 buttons). Much easier for elderly users. -->
    <integer name="config_navBarInteractionMode">0</integer>

    <!-- vophone reads notifications to show the "new messages" icon on its home screen,
         and switches between sound / vibrate / silent from its home screen ("Do not disturb" access).
         Granted from the first boot, so the user never sees these two Android settings screens. -->
    <string name="config_defaultListenerAccessPackages" translatable="false">com.bald.uriah.baldphone</string>
    <string name="config_defaultDndAccessPackages" translatable="false">com.bald.uriah.baldphone</string>
</resources>
